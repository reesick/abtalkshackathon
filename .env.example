# ABTalks agent environment template
# Copy this file to .env and fill in your credentials. Never commit .env.

# Breeth MCP
BREETH_MCP_URL=https://mcp.thebreeth.com/mcp
BREETH_API_KEY=your_breeth_api_key_here

# Flora MCP (legacy — OAuth/browser flow, unused by the unattended scheduler)
FLORA_MCP_URL=https://your-flora-mcp-url/mcp

# Flora REST API (key-authenticated, used by agent/flora_client.py)
FLORA_API_KEY=your_flora_api_key_here
FLORA_API_BASE=https://app.flora.ai/api/v1
FLORA_WORKSPACE_ID=your_flora_workspace_id
FLORA_PROJECT_ID=your_flora_project_id
FLORA_VIDEO_MODEL=r2v-gengateway-omni-flash-gg
FLORA_VIDEO_MODEL_FALLBACK=r2v-seedance-2.0-fast-enhancor

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# AWS / Bedrock (LLM)
BEDROCK_API_KEY=your_bedrock_api_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# DB (SQLite default; swap for postgresql://... on prod)
DATABASE_URL=sqlite:///./abtalks.db

# Discovery sources — all optional, each source degrades gracefully and
# logs a clear "skipped, not configured" message if its key is absent.
# RSS/HN/GitHub(unauthenticated)/Hugging Face trending papers need no keys.

# GitHub search API — optional, raises the unauthenticated rate limit
# (10 req/min) if provided. Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Product Hunt GraphQL API v2 — optional, Product Hunt collector is
# skipped entirely if absent. Create at: https://api.producthunt.com/v2/docs
PRODUCT_HUNT_API_TOKEN=

# YouTube Data API v3 — optional, YouTube collector is skipped entirely if
# either is absent. Create a key at: https://console.cloud.google.com/apis/credentials
# YOUTUBE_CHANNEL_IDS is a comma-separated list of channel IDs to monitor
# (curated list, not a platform-wide search — see integration guide section 18).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=

# Meme subsystem (see meme_intelligence_humour_system_implementation.md)
# Imgflip — template provider + renderer only, not the humour brain.
# POST-body auth per Imgflip's docs; never put these in a URL or log them.
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# Repetition cooldowns (posts between reuse) — optional, sensible defaults
# are baked into meme/templates/cooldown.py if unset.
MEME_TEMPLATE_COOLDOWN_POSTS=5
MEME_FAMILY_COOLDOWN_POSTS=2
MEME_MECHANISM_COOLDOWN_POSTS=2
MEME_OVERUSED_TEMPLATE_COOLDOWN_POSTS=8
