# ABTalks agent environment template
# Copy this file to .env and fill in your credentials. Never commit .env.

# Breeth MCP
BREETH_MCP_URL=https://mcp.thebreeth.com/mcp
BREETH_API_KEY=your_breeth_api_key_here

# Flora MCP (legacy — OAuth/browser flow, unused by the unattended scheduler)
FLORA_MCP_URL=https://your-flora-mcp-url/mcp

# Flora REST API (key-authenticated, used by agent/flora_client.py)
FLORA_API_KEY=your_flora_api_key_here
FLORA_API_BASE=https://app.flora.ai/api/v1
FLORA_WORKSPACE_ID=your_flora_workspace_id
FLORA_PROJECT_ID=your_flora_project_id
FLORA_VIDEO_MODEL=r2v-gengateway-omni-flash-gg
FLORA_VIDEO_MODEL_FALLBACK=r2v-seedance-2.0-fast-enhancor

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# AWS / Bedrock (LLM)
BEDROCK_API_KEY=your_bedrock_api_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# DB (SQLite default; swap for postgresql://... on prod)
DATABASE_URL=sqlite:///./abtalks.db
